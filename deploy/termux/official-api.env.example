# Copy to ~/rotamoto-data/official-api/runtime.env and chmod 600.
# This local development runtime uses the official database through rotamoto_app.
# It contains no password; pgpass supplies the local database credential.
NODE_ENV=development
HOST=127.0.0.1
PORT=8788
DATABASE_URL=postgresql://rotamoto_app@127.0.0.1:5432/rotamoto
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082
ROTAMOTO_APP_ROOT=/data/data/com.termux/files/home/projetos/repos/rota-moto-restaurante
ROTAMOTO_NODE_BINARY=/data/data/com.termux/files/usr/bin/node
