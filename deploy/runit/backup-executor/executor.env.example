# Copy outside the repository; keep the real file mode 0600 and private to the app UID.
ROTAMOTO_BACKUP_CONTROL_DIRECTORY=/data/data/com.termux/files/home/.local/share/rotamoto/backup-control
ROTAMOTO_BACKUP_EXECUTOR_UID=10000
ROTAMOTO_BACKUP_TERMUX_SHARED_UID=enabled
ROTAMOTO_BACKUP_TERMUX_SHARED_UID_RISK_ACK=HTTP_AND_EXECUTOR_SHARE_APP_UID
BACKUP_DATABASE_URL=postgresql://rotamoto_backup@127.0.0.1:5432/rotamoto
ROTAMOTO_BACKUP_KEY_FILE=/data/data/com.termux/files/home/.local/share/rotamoto/backup.key
ROTAMOTO_BACKUP_DIRECTORY=/data/data/com.termux/files/home/.local/share/rotamoto/recovery-sets
ROTAMOTO_MEDIA_DIRECTORY=/data/data/com.termux/files/home/.local/share/rotamoto/media
ROTAMOTO_OPERATOR_AUDIT_LOG=/data/data/com.termux/files/home/.local/share/rotamoto/operator-audit.jsonl
ROTAMOTO_BACKUP_ADMIN_AUDIT_LOG=/data/data/com.termux/files/home/.local/share/rotamoto/backup-admin-audit.jsonl
ROTAMOTO_OPERATOR_ACTOR_REF=backup-executor
