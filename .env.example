NODE_ENV=development
PORT=8787
HOST=127.0.0.1
DATABASE_URL=postgresql://rotamoto_app@127.0.0.1:5432/rotamoto
ALLOWED_ORIGIN=http://localhost:8787
# Development credentials come from the approved local PostgreSQL credential store.
# Never put passwords in this file. The HTTP process must not receive MIGRATOR_DATABASE_URL.

# Installation settings: paths belong to the service operator and must be outside the checkout/webroot.
ROTAMOTO_MEDIA_DIRECTORY=
ROTAMOTO_BACKUP_DIRECTORY=
ROTAMOTO_BACKUP_KEY_FILE=
ROTAMOTO_BACKUP_RETENTION_DAYS=30
ROTAMOTO_MEDIA_GC_GRACE_DAYS=45
PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD_REF=
SMTP_FROM=

# Local file keystore option; in production configure exactly this pair or one external provider module.
ROTAMOTO_SECRET_STORE_DIRECTORY=
ROTAMOTO_SECRET_MASTER_KEY_FILE=
ROTAMOTO_DATABASE_PASSWORD_REF=
ROTAMOTO_OPERATOR_AUDIT_LOG=
ROTAMOTO_OPERATOR_ACTOR_REF=

# Backup role URL has no password; pgpass supplies credentials. Never pass this URL to the HTTP service.
BACKUP_DATABASE_URL=
