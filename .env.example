PORT=8787
# Restrict to local clients. Set HOST explicitly only behind a secured reverse proxy.
HOST=127.0.0.1
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_AUTHORIZATION_CODE_VERIFIER=
IFOOD_ACCESS_TOKEN=
IFOOD_REFRESH_TOKEN=
IFOOD_ACCESS_TOKEN_EXPIRES_AT=0

# 99Food — keep all credentials on the server
FOOD99_BASE_URL=
FOOD99_TOKEN_URL=
FOOD99_CLIENT_ID=
FOOD99_CLIENT_SECRET=
FOOD99_ACCESS_TOKEN=
FOOD99_ACCESS_TOKEN_EXPIRES_AT=0
FOOD99_WEBHOOK_SECRET=
FOOD99_ORDERS_PATH=/orders
FOOD99_ORDER_PATH=/orders/:id
FOOD99_CONFIRM_PATH=/orders/:id/confirm
FOOD99_READY_PATH=/orders/:id/ready
FOOD99_DISPATCH_PATH=/orders/:id/dispatch
FOOD99_CANCEL_PATH=/orders/:id/cancel

# Keeta Open Delivery — secrets remain server-side
KEETA_BASE_URL=https://open.mykeeta.com/api/open/opendelivery
KEETA_TOKEN_URL=https://open.mykeeta.com/api/open/opendelivery/oauth/token
KEETA_CLIENT_ID=
KEETA_CLIENT_SECRET=
KEETA_APP_ID=
KEETA_ACCESS_TOKEN=
KEETA_REFRESH_TOKEN=
KEETA_ACCESS_TOKEN_EXPIRES_AT=0
KEETA_WEBHOOK_SECRET=

# Same-origin panel calls work locally; set this to the panel's origin when hosted elsewhere.
ALLOWED_ORIGIN=http://localhost:8787
